{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@crmagro/config": ["packages/config/src/index.ts"],
      "@crmagro/db": ["packages/db/src/index.ts"],
      "@crmagro/core": ["packages/core/src/index.ts"],
      "@crmagro/channels": ["packages/channels/src/index.ts"],
      "@crmagro/captation": ["packages/captation/src/index.ts"]
    }
  }
}
