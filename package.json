{
  "name": "crmagro",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -n web,worker -c blue,green \"pnpm --filter @crmagro/web dev\" \"pnpm --filter @crmagro/worker dev\"",
    "services": "docker compose up -d",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v && docker compose up -d",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "dotenv -e .env -- pnpm -r test",
    "db:migrate": "pnpm --filter @crmagro/db migrate:deploy",
    "db:seed:demo": "pnpm --filter @crmagro/db seed:demo",
    "db:create-user": "pnpm --filter @crmagro/db create-user",
    "start:web": "bash scripts/run-web.sh",
    "start:worker": "bash scripts/run-worker.sh",
    "demo:screenshots": "node scripts/demo/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^2": "^2.1.4",
      "nanoid@^3": "^3.3.18",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "postcss": "^8.5.23",
      "engine.io": "^6.6.10"
    }
  },
  "description": "CRM Agro: CRM de prospecção para o agro (contatos, funis, WhatsApp, fluxos de automação).",
  "license": "MIT"
}
